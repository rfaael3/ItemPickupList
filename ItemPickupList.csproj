<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ItemPickupList</AssemblyName>
    <RootNamespace>ItemPickupList</RootNamespace>

    <!-- Build only ItemPickupList.dll; do not copy game DLLs or emit PDB/dependency files. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- CONFIGURE: Risk of Rain 2 Steam installation directory. -->
    <RoR2Dir>C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</RoR2Dir>
    <Managed>$(RoR2Dir)\Risk of Rain 2_Data\Managed</Managed>

    <!-- CONFIGURE: r2modman profile containing BepInEx core, MMHOOK_RoR2.dll, and Risk of Options. -->
    <Profile>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Default</Profile>

    <!-- CONFIGURE: exact RiskOfOptions.dll path within the selected profile. -->
    <RooDll>$(Profile)\BepInEx\plugins\Rune580-Risk_Of_Options\RiskOfOptions\RiskOfOptions.dll</RooDll>
  </PropertyGroup>

  <!-- Do not copy referenced assemblies into the output directory. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- Compile the mod icon into the plugin assembly. -->
    <EmbeddedResource Include="Assets\ModIcon.png" LogicalName="ItemPickupList.ModIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game and Unity assemblies. -->
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="RoR2"><HintPath>$(Managed)\RoR2.dll</HintPath></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(Managed)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(Managed)\Unity.Addressables.dll</HintPath></Reference>

    <!-- BepInEx and hooks. -->
    <Reference Include="BepInEx"><HintPath>$(Profile)\BepInEx\core\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Profile)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(Profile)\BepInEx\core\MonoMod.RuntimeDetour.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(Profile)\BepInEx\core\MonoMod.Utils.dll</HintPath></Reference>
    <Reference Include="MMHOOK_RoR2"><HintPath>$(Profile)\BepInEx\plugins\MMHOOK\MMHOOK_RoR2.dll</HintPath></Reference>

    <!-- Risk of Options. -->
    <Reference Include="RiskOfOptions"><HintPath>$(RooDll)</HintPath></Reference>
  </ItemGroup>

</Project>
